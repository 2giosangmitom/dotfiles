{{- $flavor := includeTemplate "theme/flavor" . -}}
{{- $t := index .theme.flavors $flavor -}}
# nightfall.nvim - the {{ $flavor }} flavor
# Generated by chezmoi from .chezmoidata/theme.toml, do not edit.

[colors.primary]
foreground = "{{ $t.fg }}"
background = "{{ $t.bg }}"
dim_foreground = "{{ $t.fg_dim }}"
bright_foreground = "{{ $t.fg_bright }}"

[colors.cursor]
text = "{{ $t.bg }}"
cursor = "{{ $t.fg }}"

[colors.vi_mode_cursor]
text = "{{ $t.bg }}"
cursor = "{{ $t.accent }}"

[colors.selection]
text = "{{ $t.fg }}"
background = "{{ $t.selection }}"

[colors.search]
matches = { foreground = "{{ $t.crust }}", background = "{{ $t.search }}" }
focused_match = { foreground = "{{ $t.crust }}", background = "{{ $t.bright.blue }}" }

[colors.hints]
start = { foreground = "{{ $t.crust }}", background = "{{ $t.normal.cyan }}" }
end = { foreground = "{{ $t.crust }}", background = "{{ $t.bright.yellow }}" }

[colors.footer_bar]
foreground = "{{ $t.crust }}"
background = "{{ $t.bright.blue }}"

[colors]
line_indicator = { foreground = "{{ $t.crust }}", background = "{{ $t.peach }}" }
{{- range $group := list "normal" "bright" "dim" }}

[colors.{{ $group }}]
{{- $c := index $t $group }}
{{- range $name := list "black" "red" "green" "yellow" "blue" "magenta" "cyan" "white" }}
{{ $name }} = "{{ index $c $name }}"
{{- end }}
{{- end }}
