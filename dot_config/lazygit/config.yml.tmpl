{{- $flavor := includeTemplate "theme/flavor" . -}}
{{- $t := index .theme.flavors $flavor -}}
{{- /*
  Mirrors nightfall.nvim scripts/extras/lazygit.lua: on the light flavor,
  border and selection sit too close to bg to read as whole frames and selected
  rows, so each role steps one notch further from the background. The selected
  line is nightfall's blend(accent, bg, 0.3), which has no palette key.
*/ -}}
{{- $inactiveBorder := $t.border -}}
{{- $selectedLine := $t.selection -}}
{{- $inactiveSelectedLine := $t.border -}}
{{- if eq $flavor "winter" -}}
{{-   $inactiveBorder = $t.bright.black -}}
{{-   $selectedLine = "#b8cae3" -}}
{{-   $inactiveSelectedLine = $t.selection -}}
{{- end -}}
# nightfall.nvim - the {{ $flavor }} flavor
# Generated by chezmoi from .chezmoidata/theme.toml, do not edit.

gui:
  nerdFontsVersion: "3"
  border: rounded
  theme:
    activeBorderColor:
      - "{{ $t.accent }}"
      - "bold"
    inactiveBorderColor:
      - "{{ $inactiveBorder }}"
    searchingActiveBorderColor:
      - "{{ $t.bright.cyan }}"
    optionsTextColor:
      - "{{ $t.normal.cyan }}"
    selectedLineBgColor:
      - "{{ $selectedLine }}"
    inactiveViewSelectedLineBgColor:
      - "{{ $inactiveSelectedLine }}"
    defaultFgColor:
      - "{{ $t.fg }}"
    cherryPickedCommitBgColor:
      - "{{ $t.bg }}"
    cherryPickedCommitFgColor:
      - "{{ $t.pink }}"
    markedBaseCommitBgColor:
      - "{{ $t.bg }}"
    markedBaseCommitFgColor:
      - "{{ $t.bright.yellow }}"
    unstagedChangesColor:
      - "{{ $t.normal.red }}"
