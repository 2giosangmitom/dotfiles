{{- $flavor := includeTemplate "theme/flavor" . -}}
{{- $t := index .theme.flavors $flavor -}}
# nightfall.nvim - the {{ $flavor }} flavor
# Generated by chezmoi from .chezmoidata/theme.toml, do not edit.

[mgr]
cwd = { fg = "{{ $t.normal.cyan }}" }
find_keyword = { fg = "{{ $t.bright.yellow }}", bold = true }
find_position = { fg = "{{ $t.bright.magenta }}", bg = "reset", bold = true }
symlink_target = { fg = "{{ $t.muted }}", italic = true }
marker_copied = { fg = "{{ $t.normal.green }}", bg = "{{ $t.normal.green }}" }
marker_cut = { fg = "{{ $t.normal.red }}", bg = "{{ $t.normal.red }}" }
marker_marked = { fg = "{{ $t.bright.cyan }}", bg = "{{ $t.bright.cyan }}" }
marker_selected = { fg = "{{ $t.bright.yellow }}", bg = "{{ $t.bright.yellow }}" }
count_copied = { fg = "{{ $t.crust }}", bg = "{{ $t.normal.green }}" }
count_cut = { fg = "{{ $t.crust }}", bg = "{{ $t.normal.red }}" }
count_selected = { fg = "{{ $t.crust }}", bg = "{{ $t.bright.yellow }}" }
border_symbol = "│"
border_style = { fg = "{{ $t.border }}" }

[tabs]
active = { fg = "{{ $t.crust }}", bg = "{{ $t.accent }}", bold = true }
inactive = { fg = "{{ $t.fg }}", bg = "{{ $t.selection }}" }

[mode]
normal_main = { fg = "{{ $t.crust }}", bg = "{{ $t.accent }}", bold = true }
normal_alt = { fg = "{{ $t.accent }}", bg = "{{ $t.selection }}" }
select_main = { fg = "{{ $t.crust }}", bg = "{{ $t.normal.green }}", bold = true }
select_alt = { fg = "{{ $t.normal.green }}", bg = "{{ $t.selection }}" }
unset_main = { fg = "{{ $t.crust }}", bg = "{{ $t.pink }}", bold = true }
unset_alt = { fg = "{{ $t.pink }}", bg = "{{ $t.selection }}" }

[indicator]
parent = { fg = "{{ $t.fg }}", bg = "{{ $t.selection }}" }
current = { fg = "{{ $t.fg }}", bg = "{{ $t.selection }}" }
preview = { underline = true }

[status]
overall = { fg = "{{ $t.fg }}", bg = "{{ $t.bg }}" }
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }
perm_sep = { fg = "{{ $t.bright.black }}" }
perm_type = { fg = "{{ $t.bright.blue }}" }
perm_read = { fg = "{{ $t.bright.yellow }}" }
perm_write = { fg = "{{ $t.normal.red }}" }
perm_exec = { fg = "{{ $t.normal.green }}" }
progress_label = { fg = "{{ $t.fg_bright }}", bold = true }
progress_normal = { fg = "{{ $t.accent }}", bg = "{{ $t.selection }}" }
progress_error = { fg = "{{ $t.normal.red }}", bg = "{{ $t.selection }}" }

[which]
border = { fg = "{{ $t.accent }}" }
cols = 3
mask = { bg = "{{ $t.selection }}" }
cand = { fg = "{{ $t.normal.cyan }}" }
rest = { fg = "{{ $t.muted }}" }
desc = { fg = "{{ $t.bright.magenta }}" }
separator = "  "
separator_style = { fg = "{{ $t.border }}" }

[confirm]
border = { fg = "{{ $t.accent }}" }
title = { fg = "{{ $t.accent }}" }
body = { fg = "{{ $t.fg }}" }
list = { fg = "{{ $t.normal.cyan }}" }
btn_yes = { fg = "{{ $t.crust }}", bg = "{{ $t.normal.green }}" }
btn_no = { fg = "{{ $t.crust }}", bg = "{{ $t.normal.red }}" }

[spot]
border = { fg = "{{ $t.accent }}" }
title = { fg = "{{ $t.accent }}" }
tbl_col = { fg = "{{ $t.normal.cyan }}" }
tbl_cell = { fg = "{{ $t.crust }}", bg = "{{ $t.bright.yellow }}" }

[notify]
title_info = { fg = "{{ $t.normal.green }}" }
title_warn = { fg = "{{ $t.normal.yellow }}" }
title_error = { fg = "{{ $t.normal.red }}" }

[pick]
border = { fg = "{{ $t.accent }}" }
active = { fg = "{{ $t.bright.magenta }}", bold = true }
inactive = { fg = "{{ $t.fg }}" }

[input]
border = { fg = "{{ $t.accent }}" }
title = { fg = "{{ $t.fg }}" }
value = { fg = "{{ $t.fg }}" }
selected = { bg = "{{ $t.selection }}" }

[cmp]
border = { fg = "{{ $t.accent }}" }
active = { fg = "{{ $t.bright.magenta }}", bold = true }
inactive = { fg = "{{ $t.fg }}" }

[tasks]
border = { fg = "{{ $t.accent }}" }
title = { fg = "{{ $t.fg }}" }
hovered = { fg = "{{ $t.bright.magenta }}", underline = true }

[help]
border = { fg = "{{ $t.accent }}" }
chord = { fg = "{{ $t.normal.cyan }}" }
action = { fg = "{{ $t.bright.magenta }}" }
hovered = { bg = "{{ $t.selection }}", bold = true }

[filetype]
rules = [
  { mime = "**/image/*", fg = "{{ $t.normal.cyan }}" },
  { mime = "**/{audio,video}/*", fg = "{{ $t.bright.yellow }}" },
  { mime = "**/application/{,g}zip", fg = "{{ $t.bright.magenta }}" },
  { mime = "**/application/{tar,bzip*,7z-compressed,xz,rar}", fg = "{{ $t.bright.magenta }}" },
  { mime = "**/application/{pdf,doc,rtf}", fg = "{{ $t.normal.green }}" },
  { mime = "vfs/{absent,stale}", fg = "{{ $t.muted }}" },
  { url = "*", is = "orphan", bg = "{{ $t.normal.red }}" },
  { url = "*", is = "dummy", bg = "{{ $t.normal.red }}" },
  { url = "*/", is = "dummy", bg = "{{ $t.normal.red }}" },
  { url = "*", is = "exec", fg = "{{ $t.normal.green }}" },
  { url = "*/", fg = "{{ $t.accent }}" },
]
