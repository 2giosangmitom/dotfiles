{{- $flavor := includeTemplate "theme/flavor" . -}}
{{- $t := index .theme.flavors $flavor -}}
layout {
  gaps 16
  center-focused-column "never"

  default-column-width { proportion 0.5; }

  focus-ring {
    width 2
    active-color "{{ $t.accent }}"
    inactive-color "{{ $t.border }}"
  }

  border {
    off
  }

  shadow {
    off
  }
}
